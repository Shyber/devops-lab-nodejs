{
  "info": {
    "name": "CIRS Lab5 - Analysts",
    "_postman_id": "585786dc-60e3-473d-90fa-13b50e7d19a9",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CIRS Lab5. Fictional local data only. Start the assembled API, then run requests in order. Repeated runs use fresh generated email values. No authentication or production presence is implemented."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 GET active analysts",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('analystsTag', Date.now() + '-' + Math.floor(Math.random() * 1000000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Active analyst directory', () => { const b = pm.response.json(); pm.expect(b).to.be.an('array'); pm.expect(b.every(x => x.active && x.role === 'ANALYST')).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/analysts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "analysts"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 GET all analyst fixtures",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.collectionVariables.set('analystsBefore', pm.response.json().length); pm.test('Includes inactive fixture', () => pm.expect(pm.response.json().some(x => x.active === false)).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/analysts?active=all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "analysts"
          ],
          "query": [
            {
              "key": "active",
              "value": "all"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 POST create analyst",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const b = pm.response.json(); pm.collectionVariables.set('newAnalystId', b.id); pm.test('Generated analyst ID and defaults', () => { pm.expect(b.id).to.be.above(3); pm.expect(b.name).to.eql('Robin Taylor'); pm.expect(b.role).to.eql('ANALYST'); pm.expect(b.active).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Robin Taylor\",\n  \"email\": \"robin.{{analystsTag}}@example.test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/analysts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "analysts"
          ]
        }
      },
      "response": []
    },
    {
