              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Created analyst is readable', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('newAnalystId'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
