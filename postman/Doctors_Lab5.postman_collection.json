{
  "info": {
    "name": "Lab5 - DEVOPS-11 Doctors",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Fictional in-memory demonstration. Run requests in order against the local Express server."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "doctorId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List doctors",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/doctors"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create a doctor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/doctors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Julie\",\n  \"specialty\": \"Neurology\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('doctorId', pm.response.json().id);",
              "pm.test('Created fields', () => { const b = pm.response.json(); pm.expect(b.name).to.eql('Dr. Julie'); pm.expect(b.specialty).to.eql('Neurology'); pm.expect(b.id).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read created doctor",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/doctors/{{doctorId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Same ID', () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('doctorId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/doctors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Julie\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Whitespace name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/doctors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"   \",\n  \"specialty\": \"Neurology\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid specialty type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/doctors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Julie\",\n  \"specialty\": 23\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing doctor",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/doctors/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
