{
  "info": {
    "name": "CIRS Lab5 - Incidents",
    "_postman_id": "76368848-dea6-47d5-aa69-78f018fcf182",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CIRS Lab5. Fictional local data only. Start the assembled API, then run requests in order. Repeated runs use fresh generated email values. No authentication or production presence is implemented."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 GET all incidents",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.collectionVariables.set('incidentsBefore', pm.response.json().length); pm.test('Incident array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 POST create incident",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const b = pm.response.json(); pm.collectionVariables.set('newIncidentId', b.id); pm.test('SRS creation defaults', () => { pm.expect(b.status).to.eql('REPORTED'); pm.expect(b.priority).to.eql('MEDIUM'); pm.expect(b.assignedAnalystId).to.eql(null); pm.expect(b.reporterId).to.eql(100); pm.expect(b.history[0].action).to.eql('CREATED'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Fictional phishing training report\",\n  \"description\": \"This fictional message is used to test the CIRS classroom demonstration.\",\n  \"categoryId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents"
          ]
        }
      },
      "response": []
    },
    {
