              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Read back saved incident', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('newIncidentId'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/incidents/{{newIncidentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents",
            "{{newIncidentId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 GET combined filters",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('All three filters match', () => { const b = pm.response.json(); pm.expect(b.length).to.be.above(0); pm.expect(b.every(x => x.status === 'IN_PROGRESS' && x.priority === 'CRITICAL' && x.categoryId === 4)).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/incidents?status=IN_PROGRESS&priority=CRITICAL&category=Malware",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents"
          ],
          "query": [
            {
              "key": "status",
              "value": "IN_PROGRESS"
            },
            {
              "key": "priority",
              "value": "CRITICAL"
            },
            {
              "key": "category",
              "value": "Malware"
            }
          ]
        }
