{
  "info": {
    "name": "Lab5 - DEVOPS-13 Appointments",
    "description": "Fictional in-memory Lab5 demonstration. Run requests in order with the local server running. Successful POST requests add data; restart resets the stores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "doctorId",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create doctor for appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/doctors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Visit\",\n  \"specialty\": \"Neurology\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('doctorId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create patient for appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/patients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Visit Patient\",\n  \"age\": 34\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('patientId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List appointments",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/appointments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Schedule appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"patientId\": {{patientId}},\n  \"date\": \"2027-03-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Appointment references', function () { const b = pm.response.json(); pm.expect(b.doctorId).to.equal(Number(pm.collectionVariables.get('doctorId'))); pm.expect(b.patientId).to.equal(Number(pm.collectionVariables.get('patientId'))); pm.expect(b.date).to.equal('2027-03-15'); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('appointmentId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read created appointment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/appointments/{{appointmentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Same ID', function () { pm.expect(String(pm.response.json().id)).to.equal(String(pm.collectionVariables.get('appointmentId'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/appointments",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid ID type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctorId\": \"wrong\",\n  \"patientId\": {{patientId}},\n  \"date\": \"2027-03-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Impossible date",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"patientId\": {{patientId}},\n  \"date\": \"2027-02-30\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing doctor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctorId\": 999999,\n  \"patientId\": {{patientId}},\n  \"date\": \"2027-03-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"patientId\": 999999,\n  \"date\": \"2027-03-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing appointment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/appointments/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}
