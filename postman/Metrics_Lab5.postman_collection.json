              "pm.test('Exact SCRUM-14 response keys', () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['activeIncidents', 'criticalAlerts', 'onlineAnalysts', 'status', 'system', 'systemUptime']));",
              "pm.test('Counts agree with the incident data', () => { const b = pm.response.json(); pm.expect(b.activeIncidents).to.eql(Number(pm.collectionVariables.get('expectedActive'))); pm.expect(b.criticalAlerts).to.eql(Number(pm.collectionVariables.get('expectedCritical'))); });",
              "pm.test('Operational API and fictional presence fixture', () => { const b = pm.response.json(); pm.expect(b.system).to.eql('Cyber Incident Reporting System'); pm.expect(b.status).to.eql('Operational'); pm.expect(b.onlineAnalysts).to.eql(1); pm.expect(b.systemUptime).to.be.at.least(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/metrics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "metrics"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05 POST metrics is refused",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 405', () => pm.response.to.have.status(405));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Structured error', () => { const b = pm.response.json(); pm.expect(b.error).to.eql(true); pm.expect(b.code).to.be.a('string'); pm.expect(b.message).to.be.a('string'); pm.expect(b).not.to.have.property('stack'); });",
              "pm.test('Read-only Allow header', () => pm.expect(pm.response.headers.get('Allow')).to.eql('GET'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"activeIncidents\": 900\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/metrics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "metrics"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06 GET unsupported metrics filter",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Structured error', () => { const b = pm.response.json(); pm.expect(b.error).to.eql(true); pm.expect(b.code).to.be.a('string'); pm.expect(b.message).to.be.a('string'); pm.expect(b).not.to.have.property('stack'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/metrics?priority=HIGH",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "metrics"
          ],
          "query": [
            {
              "key": "priority",
              "value": "HIGH"
            }
          ]
        }
      },
      "response": []
    },
