{
  "info": {
    "name": "CIRS Lab5 - Metrics",
    "_postman_id": "8c403a0a-8265-4717-8810-df508a4ecc9f",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CIRS Lab5. Fictional local data only. Start the assembled API, then run requests in order. Repeated runs use fresh generated email values. No authentication or production presence is implemented."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 GET current incidents for expected counts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const active = pm.response.json().filter(x => !['CLOSED', 'REJECTED'].includes(x.status)); pm.collectionVariables.set('expectedActive', active.length); pm.collectionVariables.set('expectedCritical', active.filter(x => x.priority === 'CRITICAL').length);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 GET data-derived metrics",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Exact SCRUM-14 response keys', () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['activeIncidents', 'criticalAlerts', 'onlineAnalysts', 'status', 'system', 'systemUptime']));",
              "pm.test('Counts agree with the incident data', () => { const b = pm.response.json(); pm.expect(b.activeIncidents).to.eql(Number(pm.collectionVariables.get('expectedActive'))); pm.expect(b.criticalAlerts).to.eql(Number(pm.collectionVariables.get('expectedCritical'))); });",
              "pm.test('Operational API and fictional presence fixture', () => { const b = pm.response.json(); pm.expect(b.system).to.eql('Cyber Incident Reporting System'); pm.expect(b.status).to.eql('Operational'); pm.expect(b.onlineAnalysts).to.eql(1); pm.expect(b.systemUptime).to.be.at.least(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/metrics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "metrics"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 POST a new Medium incident",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.collectionVariables.set('expectedActive', Number(pm.collectionVariables.get('expectedActive')) + 1); pm.test('New report starts Medium', () => pm.expect(pm.response.json().priority).to.eql('MEDIUM'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Fictional phishing training report\",\n  \"description\": \"This fictional message is used to test the CIRS classroom demonstration.\",\n  \"categoryId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents"
          ]
        }
      },
      "response": []
    },
    {
