{
  "info": {
    "name": "Metrics API Lab 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Hospital Metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/metrics",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "metrics"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Hospital information', () => {",
              "  pm.expect(body.hospital).to.eql('Central Hospital');",
              "  pm.expect(body.status).to.eql('Operational');",
              "});",
              "pm.test('Hospital metrics', () => {",
              "  for (const key of ['totalDoctors', 'totalPatients', 'activeAppointments', 'systemUptime']) {",
              "    pm.expect(body[key], key).to.be.a('number');",
              "    pm.expect(body[key], key).to.be.at.least(0);",
              "  }",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
