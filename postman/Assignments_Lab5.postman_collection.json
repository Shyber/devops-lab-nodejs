{
  "info": {
    "name": "CIRS Lab5 - Assignments",
    "_postman_id": "f1b64caa-dbfe-432c-a0a6-7b8094001958",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CIRS Lab5. Fictional local data only. Start the assembled API, then run requests in order. Repeated runs use fresh generated email values. No authentication or production presence is implemented."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 GET existing assignments",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('assignmentsTag', Date.now() + '-' + Math.floor(Math.random() * 1000000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Assignment projections', () => { const b = pm.response.json(); pm.expect(b).to.be.an('array'); pm.expect(b.every(x => Number.isInteger(x.incidentId) && Number.isInteger(x.analystId))).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/assignments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments"
          ]
        }
      },
      "response": []
    },
    {
