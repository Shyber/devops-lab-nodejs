              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Existing incident becomes Assigned', () => { const b = pm.response.json(); pm.expect(b.incidentId).to.eql(Number(pm.collectionVariables.get('assignmentIncidentId'))); pm.expect(b.analystId).to.eql(Number(pm.collectionVariables.get('assignmentAnalystId'))); pm.expect(b.status).to.eql('ASSIGNED'); });"
            ]
